<?xml version="1.0" encoding="utf-8"?>
<!--
  精卫填海 - 建筑定义
  ===========================================

  本文件定义了"水体填充标记"建筑。
  - 玩家在水格上放置此标记（C# PlaceWorker 允许在水上放置）
  - 殖民者会用"挖掘"(Mining) 工作类型去完成此建筑的建造框架（Frame）
  - 建造完成的瞬间，C# ThingComp (CompFillWater) 会把这一格的地形从水变为"土壤"
  - 然后标记建筑自动销毁，留下陆地
-->
<Defs>

  <!--
    水体填充标记
    - ParentName="BuildingBase": 继承原版基础建筑父类
    - size=(1,1): 占地 1x1 格
    - passability=Standable: 殖民者可站在格子上（已变为陆地后）
    - 注意：terrainAffordanceNeeded 留空，由 C# PlaceWorker 控制是否可放置（仅允许在水格上）
  -->
  <ThingDef ParentName="BuildingBase">
    <!-- defName 唯一标识。前缀 JWFH_ = Jing Wei Fills Sea -->
    <defName>JWFH_WaterFiller</defName>
    <label>水体填充标记</label>
    <description>殖民者会以"挖掘"工作类型花费大量工作量，将这一格的水体变为土壤。完成后标记自动消失。</description>

    <!-- 占地尺寸 -->
    <size>(1,1)</size>

    <!-- 建筑菜单分类。此处放在 Structure (结构) 分类下 -->
    <designationCategory>Structure</designationCategory>

    <!-- 拖拽框选：使用 Fill2D 样式，支持 FilledRectangle（矩形框选）与 FilledOval（椭圆框选） -->
    <drawStyleCategory>Fill2D</drawStyleCategory>

    <statBases>
      <MaxHitPoints>50</MaxHitPoints>          <!-- 耐久度（标记很脆弱） -->
      <!--
        WorkToBuild: 建造工作量。
        用户要求"高工作量"，所以默认设为 48000（约 4 个游戏日）。
        实际有效工作量 = 此值 × Mod 设置中的"工作量倍率"(默认 1.0)
      -->
      <WorkToBuild>48000</WorkToBuild>
      <Flammability>0</Flammability>            <!-- 不可燃 -->
      <Beauty>-3</Beauty>                       <!-- 略影响美观 -->
      <Mass>1</Mass>
    </statBases>

    <!-- 材料成本。设为空表示无需材料，只需工作量 -->
    <costList>
    </costList>

    <!-- 通过性: Standable（标记本身不阻挡通行） -->
    <passability>Standable</passability>
    <fillPercent>0.05</fillPercent>

    <!--
      terrainAffordanceNeeded 显式清空：BuildingBase 继承的 Light 会让浅水等水体无法放置
      （报错"需要支持的地形：轻型"）。清空后由 C# PlaceWorker_WaterOnly 控制可放置位置，
      仅允许水体/沼泽。
    -->
    <terrainAffordanceNeeded />

    <!-- 是否可旋转 -->
    <rotatable>false</rotatable>

    <!-- 贴图：使用本模组自带的占位贴图（标记建筑完成后立即销毁，仅建造期间显示）。 -->
    <graphicData>
      <texPath>Buildings/WaterFiller</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(0.5,0.5)</drawSize>
    </graphicData>

    <!-- 1.6 起 blueprintGraphicData 字段已移除，蓝图外观自动由 graphicData 派生，不再单独声明 -->

    <uiIconPath>Buildings/WaterFiller</uiIconPath>

    <!--
      ThingComp: 自定义组件
      - Class 必须指向 C# 中的 CompProperties 子类
      - replaceWithTerrain: 完成后将水格替换为哪种陆地地形（默认: Soil 土壤）
      - destroySelfOnComplete: 完成后是否销毁标记本身
    -->
    <comps>
      <li Class="JWFH.CompProperties_FillWater">
        <replaceWithTerrainDefName>Soil</replaceWithTerrainDefName>
        <destroySelfOnComplete>true</destroySelfOnComplete>
      </li>
    </comps>

    <!--
      PlaceWorker: 自定义放置规则类
      - Class 指向 C# 中的 PlaceWorker 子类
      - 必须带完整命名空间 JWFH.PlaceWorker_WaterOnly，否则 1.6 无法解析到该类
    -->
    <placeWorkers>
      <li>JWFH.PlaceWorker_WaterOnly</li>
    </placeWorkers>

    <!-- 研究前置。需要先研究 JWFH_WaterFilling 才能建造此标记 -->
    <researchPrerequisites>
      <li>JWFH_WaterFilling</li>
    </researchPrerequisites>
  </ThingDef>

  <!--
    注水标记（陆地 -> 水体）
    - 与"水体填充标记"方向相反：把陆地/任意地形灌成水体
    - 与愚公填山类似，本标记【没有】PlaceWorker，因此可在任意可建造格子放置
    - 建造完成瞬间，C# ThingComp (CompFillToWater) 把这一格变为水体（默认 WaterShallow）
    - 然后标记自动销毁，留下水体
  -->
  <ThingDef ParentName="BuildingBase">
    <!-- defName 唯一标识。JWFH_FloodFiller = 注水/灌水标记 -->
    <defName>JWFH_FloodFiller</defName>
    <label>注水标记</label>
    <description>殖民者会以"挖掘"工作类型花费大量工作量，将这一格变为水体。放置位置不限（尤其适合陆地）。完成后标记自动消失。</description>

    <!-- 占地尺寸 -->
    <size>(1,1)</size>

    <!-- 建筑菜单分类。此处放在 Structure (结构) 分类下 -->
    <designationCategory>Structure</designationCategory>

    <!-- 拖拽框选：使用 Fill2D 样式，支持 FilledRectangle（矩形框选）与 FilledOval（椭圆框选） -->
    <drawStyleCategory>Fill2D</drawStyleCategory>

    <statBases>
      <MaxHitPoints>50</MaxHitPoints>          <!-- 耐久度（标记很脆弱） -->
      <WorkToBuild>48000</WorkToBuild>          <!-- 高工作量，与水体填充标记一致 -->
      <Flammability>0</Flammability>            <!-- 不可燃 -->
      <Beauty>-3</Beauty>                       <!-- 略影响美观 -->
      <Mass>1</Mass>
    </statBases>

    <!-- 材料成本。设为空表示无需材料，只需工作量 -->
    <costList>
    </costList>

    <!-- 通过性: Standable（标记本身不阻挡通行） -->
    <passability>Standable</passability>
    <fillPercent>0.05</fillPercent>

    <!-- 是否可旋转 -->
    <rotatable>false</rotatable>

    <!-- 贴图：使用本模组自带的"注水标记"占位贴图。 -->
    <graphicData>
      <texPath>Buildings/FloodFiller</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(0.5,0.5)</drawSize>
    </graphicData>

    <!-- 1.6 起 blueprintGraphicData 字段已移除，蓝图外观自动由 graphicData 派生，不再单独声明 -->

    <uiIconPath>Buildings/FloodFiller</uiIconPath>

    <!--
      ThingComp: 自定义组件
      - Class 必须指向 C# 中的 CompProperties 子类
      - convertToWaterDefName: 完成后变成哪种水体地形（默认 WaterShallow 浅水）
      - destroySelfOnComplete: 完成后是否销毁标记本身
    -->
    <comps>
      <li Class="JWFH.CompProperties_FillToWater">
        <convertToWaterDefName>WaterShallow</convertToWaterDefName>
        <destroySelfOnComplete>true</destroySelfOnComplete>
      </li>
    </comps>

    <!-- 无 placeWorkers：可放置在任意格子（尤其是陆地），符合"到处填"的意图 -->

    <!-- 研究前置。需要先研究 JWFH_WaterFilling 才能建造此标记 -->
    <researchPrerequisites>
      <li>JWFH_WaterFilling</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>
